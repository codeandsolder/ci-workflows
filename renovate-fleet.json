{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Fleet-wide CI-gated automerge for all proposed dependency updates with a 72-hour external crates.io release-age quarantine and weekly quarantined Rust nightly updates; first-party Git dependencies and trust roots are exempt.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>codeandsolder/ci-workflows:renovate-ci-trust-root"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": null,
  "cargo": {
    "minimumReleaseAgePackageManagerSync": true,
    "minimumReleaseAgePackageManager": "3 days"
  },
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 6,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 1,
  "rebaseWhen": "auto",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Batch compatible stable Cargo updates into one green-CI merge",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Routine stable Cargo updates",
      "groupSlug": "routine-stable-cargo"
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/btls-fast(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "BTLS git family",
      "groupSlug": "btls-git-family"
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/wreq-exp(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Wreq git family",
      "groupSlug": "wreq-git-family"
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/quiescence(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Quiescence git family",
      "groupSlug": "quiescence-git-family"
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/quiche-fast(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Quiche git family",
      "groupSlug": "quiche-git-family"
    },
    {
      "description": "Enable CI-gated PR automerge for every dependency update and clear inherited generic age delays; the following rule enforces the external registry crate quarantine.",
      "matchPackageNames": [
        "/.*/"
      ],
      "minimumReleaseAge": null,
      "minimumReleaseAgeBuffer": null,
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "External crates.io releases must age for 72 hours; Git-sourced dependencies use a different datasource.",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "Weekly CI-gated native dated nightly updates. Rust's datasource timestamps have date-only precision; four calendar days conservatively cover the three elapsed days enforced by shared CI.",
      "matchManagers": [
        "rust-toolchain"
      ],
      "matchDatasources": [
        "rust-version"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchFileNames": [
        "/^rust-toolchain\\.toml$/"
      ],
      "matchCurrentValue": "/^nightly-\\d{4}-\\d{2}-\\d{2}$/",
      "allowedVersions": "/^nightly-\\d{4}-\\d{2}-\\d{2}$/",
      "groupName": "Pinned Rust nightly",
      "groupSlug": "pinned-rust-nightly",
      "schedule": [
        "* * * * 1"
      ],
      "timezone": "Etc/UTC",
      "updateNotScheduled": false,
      "minimumReleaseAge": "4 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "ignoreUnstable": false
    }
  ],
  "platformAutomerge": false,
  "ignoreTests": false,
  "automerge": true,
  "automergeType": "pr"
}
