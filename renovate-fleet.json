{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Fleet-wide Renovate defaults: green CI automerges compatible dependencies and immutable action digests, breaking updates stay reviewable, and new crates respect release-age quarantine.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>codeandsolder/ci-workflows:renovate-ci-trust-root"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 6,
  "prHourlyLimit": 3,
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Do not deadlock immutable pins, digests and lockfile-only updates on missing upstream release timestamps (Renovate #45236)",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "GitHub-hosted runner labels have no release timestamps and major runner updates still require review",
      "matchDepTypes": [
        "github-runner"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Automerge compatible 1.x+ minor and patch updates, pins and digests after required CI",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge 0.x patch updates, but review potentially breaking 0.x minor changes",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Batch compatible stable Cargo updates into one green-CI merge",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Routine stable Cargo updates",
      "groupSlug": "routine-stable-cargo",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge SHA-pinned third-party GitHub Actions after age-gated CI",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Breaking major updates always require review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Package replacement updates always require review",
      "matchUpdateTypes": [
        "replacement"
      ],
      "automerge": false
    }
  ],
  "platformAutomerge": false,
  "ignoreTests": false
}
