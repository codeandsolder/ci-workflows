{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Fleet-wide CI-gated automerge with a 72-hour external crates.io release-age quarantine and weekly quarantined Rust nightly updates; first-party Git dependencies and trust roots are exempt.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>codeandsolder/ci-workflows:renovate-ci-trust-root"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": null,
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 6,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 1,
  "rebaseWhen": "auto",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Automerge compatible 1.x+ minor and patch updates, pins and digests after required CI",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge 0.x patch updates, but review potentially breaking 0.x minor changes",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Batch compatible stable Cargo updates into one green-CI merge",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Routine stable Cargo updates",
      "groupSlug": "routine-stable-cargo",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge SHA-pinned third-party GitHub Actions after green CI",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Breaking major updates always require review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Package replacement updates always require review",
      "matchUpdateTypes": [
        "replacement"
      ],
      "automerge": false
    },
    {
      "description": "Rust toolchain updates change compiler/lint diagnostics and the default build toolchain, even when Renovate calls 1.99 to 1.100 a compatible minor. Propose PRs for human review rather than silently raising per-repository compiler pins/MSRV.",
      "matchManagers": [
        "rust-toolchain"
      ],
      "automerge": false
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/btls-fast(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "BTLS git family",
      "groupSlug": "btls-git-family"
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/wreq-exp(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Wreq git family",
      "groupSlug": "wreq-git-family"
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/quiescence(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Quiescence git family",
      "groupSlug": "quiescence-git-family"
    },
    {
      "description": "Group Cargo Git digest updates from the same first-party source to preserve shared type and native-link identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/codeandsolder\\/quiche-fast(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Quiche git family",
      "groupSlug": "quiche-git-family"
    },
    {
      "description": "Clear inherited generic age delays; the following rule enforces the external registry crate quarantine.",
      "matchPackageNames": [
        "/.*/"
      ],
      "minimumReleaseAge": null,
      "minimumReleaseAgeBuffer": null
    },
    {
      "description": "External crates.io releases must age for 72 hours; Git-sourced dependencies use a different datasource.",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "Weekly CI-gated native dated nightly updates. Rust's datasource timestamps have date-only precision; four calendar days conservatively cover the three elapsed days enforced by shared CI.",
      "matchManagers": [
        "rust-toolchain"
      ],
      "matchDatasources": [
        "rust-version"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchFileNames": [
        "/^rust-toolchain\\.toml$/"
      ],
      "matchCurrentValue": "/^nightly-\\d{4}-\\d{2}-\\d{2}$/",
      "allowedVersions": "/^nightly-\\d{4}-\\d{2}-\\d{2}$/",
      "groupName": "Pinned Rust nightly",
      "groupSlug": "pinned-rust-nightly",
      "schedule": [
        "* * * * 1"
      ],
      "timezone": "Etc/UTC",
      "updateNotScheduled": false,
      "minimumReleaseAge": "4 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "ignoreUnstable": false,
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "platformAutomerge": false,
  "ignoreTests": false
}
