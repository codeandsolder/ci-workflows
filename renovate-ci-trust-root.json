{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Automerge pinned first-party shared CI and strict Rust SHA updates only after consumer CI succeeds.",
  "packageRules": [
    {
      "description": "SHA-pinned first-party shared CI trust roots, validated by consumer CI",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "/^codeandsolder\\/(?:ci-workflows|rust-skills2)(?:\\/|$)/"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "Shared CI trust roots",
      "groupSlug": "shared-ci-trust-roots",
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "platformAutomerge": false,
  "ignoreTests": false
}
