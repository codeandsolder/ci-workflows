[Unit]
Description=Shared CI superseded GitHub Actions workflow guard
Documentation=https://github.com/codeandsolder/ci-workflows
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/ci-workflows
Environment=PATH=/usr/local/bin:/usr/bin:/bin
RuntimeDirectory=ci-workflows
ExecStart=/usr/bin/flock --nonblock %t/ci-workflows/fleet-guard.lock /usr/bin/node %h/projects/ci-workflows/scripts/fleet-ci-guard.mjs --apply --hours 72
TimeoutStartSec=8min
NoNewPrivileges=yes
